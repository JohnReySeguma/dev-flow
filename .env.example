# Copy to .env.local and fill in. Never commit .env.local.
# The frontend holds no secrets: NEXT_PUBLIC_* values are compiled into the browser bundle,
# so API keys and passwords belong in the API's .env, never here.

# DevFlow API base URL. Leave empty for demo mode (local data, no API).
# Local API (npm run dev or docker compose in ../DevFlow-be): http://localhost:4000/api/v2
NEXT_PUBLIC_API_URL=
