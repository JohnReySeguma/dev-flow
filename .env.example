# Copy to .env.local and fill in. Never commit .env.local.
# The frontend holds no secrets: NEXT_PUBLIC_* values are compiled into the browser bundle,
# so API keys and passwords belong in the API's .env, never here.

# DevFlow API base URL: the local API (npm run dev or docker compose in ../DevFlow-be).
# Leave it empty for demo mode: sample data in the browser, no request to any server.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v2
